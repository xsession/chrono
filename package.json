{
  "name": "chrono-next",
  "description": "Cross-platform Git client with desktop and Android companion applications",
  "author": {
    "name": "CodeLayer",
    "email": "noreply@codelayer.hu"
  },
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "vite:dev": "vite",
    "server": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "start": "npm run server",
    "test:markers": "node tests/conflict-markers.test.mjs",
    "test:graph": "node --experimental-strip-types tests/graph-layout.test.ts",
    "test:bitbucket": "node --experimental-strip-types --no-warnings tests/bitbucket-server.test.ts",
    "test:hosting": "node --experimental-strip-types --no-warnings tests/hosting.test.ts",
    "test:history-window": "node --experimental-strip-types tests/history-window.test.ts",
    "test:history-columns": "node --experimental-strip-types tests/history-columns.test.ts",
    "test:refs": "node --experimental-strip-types tests/ref-groups.test.mjs",
    "test:ref-visibility": "node --experimental-strip-types tests/ref-visibility.test.ts",
    "test:ui-contract": "node tests/ui-action-coverage.mjs",
    "test:git": "bash tests/git-operation-state-smoke.sh && bash tests/conflict-center-smoke.sh && bash tests/rebase-planner-smoke.sh && bash tests/git-intelligence-smoke.sh",
    "test:api": "node --experimental-strip-types tests/api-smoke.mjs",
    "test:sagas": "node tests/saga-bridge.test.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:roadmap": "node --experimental-strip-types tests/roadmap-features.test.ts",
    "test:lines": "node --experimental-strip-types tests/line-staging.test.ts",
    "test:submodules": "node --experimental-strip-types tests/submodules.test.ts",
    "test:trust": "node --experimental-strip-types tests/trust.test.ts",
    "test:lanes": "node --experimental-strip-types tests/gitLanes.test.ts",
    "test:landscape": "node --experimental-strip-types tests/landscape.test.ts",
    "test:folders": "node --experimental-strip-types tests/folders.test.ts",
    "test:watch": "node --experimental-strip-types tests/repoWatch.test.ts",
    "test:stash-history": "node --experimental-strip-types tests/history-stash.test.ts",
    "test:nested-commit": "node --experimental-strip-types tests/nested-commit.test.ts",
    "test:ai": "node --experimental-strip-types tests/ai.test.ts",
    "test:local-llm": "node --experimental-strip-types tests/local-llm.test.ts",
    "tui": "node --experimental-strip-types --no-warnings tui/main.ts",
    "test:tui": "node tests/tui.test.mjs",
    "test:forks": "node --experimental-strip-types tests/forks.test.ts",
    "icons": "python3 scripts/make-icons.py",
    "version:sync": "node scripts/sync-version.mjs",
    "test:unit": "npm run test:markers && npm run test:graph && npm run test:history-window && npm run test:history-columns && npm run test:refs && npm run test:ref-visibility && npm run test:ui-contract && npm run test:sagas",
    "test:all": "npm run test:unit && npm run test:lines && npm run test:submodules && npm run test:trust && npm run test:lanes && npm run test:landscape && npm run test:folders && npm run test:watch && npm run test:roadmap && npm run test:bitbucket && npm run test:hosting && npm run test:git && npm run test:api && npm run test:stash-history && npm run test:nested-commit && npm run test:ai && npm run test:local-llm && npm run test:tui && npm run test:forks",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:deb": "npm run build && electron-builder --linux deb --publish never",
    "dist:arch": "npm run build && electron-builder --linux pacman --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:server": "npm run build && node scripts/package-server.mjs"
  },
  "bin": {
    "chrono-tui": "bin/chrono-tui.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@capacitor/core": "^7.4.3",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "xterm": "^5.3.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "node-pty": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "hu.codelayer.chrono",
    "productName": "Chrono",
    "copyright": "Copyright © CodeLayer",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "server/**/*",
      "tui/**/*",
      "!tui/tsconfig.json",
      "!server/**/*.tsbuildinfo",
      "dist/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/{deps,src,scripts,typings,node-addon-api}/**",
      "!node_modules/node-pty/binding.gyp"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "server/**",
      "tui/**",
      "dist/**",
      "public/**",
      "node_modules/ws/**",
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/**",
      "node_modules/@opentelemetry/api/**",
      "node_modules/standardwebhooks/**",
      "node_modules/@stablelib/base64/**",
      "node_modules/fast-sha256/**",
      "node_modules/json-schema-to-ts/**",
      "node_modules/@babel/runtime/**",
      "node_modules/ts-algebra/**"
    ],
    "extraResources": [
      {
        "from": "shell-integration",
        "to": "shell-integration"
      }
    ],
    "protocols": [
      {
        "name": "Chrono",
        "schemes": [
          "chrono"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "category": "Development",
      "executableName": "chrono",
      "icon": "build/icons",
      "synopsis": "GitKraken-style Git client with a TortoiseGit-style file explorer",
      "description": "Chrono is a cross-platform Git client: commit graph, staging down to single lines, interactive rebase, conflict center, worktrees, and a TortoiseGit-style working-copy explorer and file-manager menu.",
      "desktop": {
        "entry": {
          "StartupWMClass": "Chrono"
        }
      }
    },
    "deb": {
      "depends": [
        "git",
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2",
        "libcups2"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "rpm": {
      "depends": [
        "git",
        "gtk3",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "mesa-libgbm",
        "alsa-lib",
        "cups-libs"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "pacman": {
      "depends": [
        "git",
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "mesa",
        "alsa-lib",
        "libcups"
      ],
      "afterInstall": "build/linux/after-install.sh",
      "afterRemove": "build/linux/after-remove.sh"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chrono",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/xsession/chrono",
  "repository": {
    "type": "git",
    "url": "https://github.com/xsession/chrono.git"
  }
}
