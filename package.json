{
  "name": "chrono-next",
  "description": "Cross-platform Git client with desktop and Android companion applications",
  "author": "CodeLayer",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "vite:dev": "vite --host 0.0.0.0",
    "server": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "start": "npm run server",
    "test:markers": "node tests/conflict-markers.test.mjs",
    "test:git": "bash tests/git-operation-state-smoke.sh && bash tests/conflict-center-smoke.sh && bash tests/rebase-planner-smoke.sh && bash tests/git-intelligence-smoke.sh",
    "test:api": "node --experimental-strip-types tests/api-smoke.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "hu.codelayer.chrono", "productName": "Chrono", "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [{"from":"dist","to":"dist"},{"from":"public","to":"public"},{"from":"server","to":"server"}],
    "linux": { "target": ["AppImage"], "category": "Development" },
    "win": { "target": ["nsis", "portable"] }, "mac": { "target": ["dmg"] }
  }
}
