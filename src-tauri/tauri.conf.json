{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitAhead Next",
  "version": "0.5.0",
  "identifier": "com.gitahead.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "GitAhead Next",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 650,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Qt-free Git desktop client"
  }
}
