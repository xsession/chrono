diff --git a/next/src/types.ts b/next/src/types.ts
index 8c1be52..0c0e7bc 100644
--- a/next/src/types.ts
+++ b/next/src/types.ts
@@ -151,3 +151,135 @@ export type PullRequestRecord = {
